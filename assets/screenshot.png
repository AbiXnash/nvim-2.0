<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e1e2e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#11111b;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#bg)"/>
  <!-- Statusline -->
  <rect x="0" y="0" width="800" height="30" fill="#181825"/>
  <rect x="0" y="470" width="800" height="30" fill="#181825"/>
  <!-- Editor area lines -->
  <line x1="20" y1="80" x2="780" y2="80" stroke="#313244" stroke-width="1"/>
  <line x1="20" y1="120" x2="780" y2="120" stroke="#313244" stroke-width="1"/>
  <line x1="20" y1="160" x2="780" y2="160" stroke="#313244" stroke-width="1"/>
  <line x1="20" y1="200" x2="780" y2="200" stroke="#313244" stroke-width="1"/>
  <!-- Cursor line -->
  <rect x="0" y="118" width="800" height="24" fill="#313244" opacity="0.5"/>
  <!-- Code example -->
  <text x="30" y="60" font-family="monospace" font-size="12" fill="#6c7086">lua/abx/init.lua</text>
  <text x="30" y="100" font-family="monospace" font-size="14" fill="#cdd6f4"><tspan fill="#cba6f7">local</tspan> <tspan fill="#89b4fa">C</tspan> <tspan fill="#cba6f7">=</tspan> <tspan fill="#89b4fa">require</tspan><tspan fill="#cdd6f4">(</tspan><tspan fill="#a6e3a1">"abx.config"</tspan><tspan fill="#cdd6f4">)</tspan></text>
  <text x="30" y="124" font-family="monospace" font-size="14" fill="#cdd6f4"><tspan fill="#f38ba8">Config.editor</tspan> <tspan fill="#cba6f7">=</tspan> {</text>
  <text x="50" y="148" font-family="monospace" font-size="14" fill="#cdd6f4"><tspan fill="#f9e2af">cursorlineopt</tspan> <tspan fill="#cba6f7">=</tspan> <tspan fill="#a6e3a1">"both"</tspan>,</text>
  <text x="50" y="172" font-family="monospace" font-size="14" fill="#cdd6f4"><tspan fill="#f9e2af">tabstop</tspan> <tspan fill="#cba6f7">=</tspan> <tspan fill="#fab387">4</tspan>,</text>
  <text x="30" y="196" font-family="monospace" font-size="14" fill="#cdd6f4">}</text>
  <!-- Statusline content -->
  <text x="20" y="22" font-family="monospace" font-size="12" fill="#cdd6f4" font-weight="bold">NORMAL</text>
  <text x="120" y="22" font-family="monospace" font-size="12" fill="#a6adc8">main</text>
  <text x="250" y="22" font-family="monospace" font-size="12" fill="#f38ba8">●</text>
  <text x="265" y="22" font-family="monospace" font-size="12" fill="#f9e2af">●</text>
  <text x="280" y="22" font-family="monospace" font-size="12" fill="#89dceb">●</text>
  <text x="295" y="22" font-family="monospace" font-size="12" fill="#6c7086">●</text>
  <text x="750" y="22" font-family="monospace" font-size="12" fill="#a6adc8">lua</text>
  <text x="20" y="492" font-family="monospace" font-size="12" fill="#cdd6f4">1:1</text>
  <text x="50" y="492" font-family="monospace" font-size="12" fill="#6c7086">Top</text>
</svg>
